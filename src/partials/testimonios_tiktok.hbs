<section class="testimonios">
    <div class="content">
        <div class="testimonios__header">
            <h2 class="testimonios__title">No lo decimos nosotros,<br>Sus historias son nuestra mejor carta de presentación.</h2>
        </div>
        <div class="testimonios__muro">
            {{#each testimonios}}
                <div class="testimonio-card">
                    <div class="testimonio-card__top">
                        <img src="{{this.avatar}}" alt="{{this.autor}}" class="testimonio-card__avatar" loading="lazy"/>
                        <div class="testimonio-card__info">
                            <span class="testimonio-card__nombre">{{this.autor}}</span>
                            <span class="testimonio-card__usuario">{{this.usuario}}</span>
                        </div>
                        <svg class="testimonio-card__icono" viewBox="0 0 24 24" fill="currentColor" aria-label="TikTok">
                            <path d="M16.6 5.82c-1.02-.9-1.6-2.19-1.6-3.6h-3.13v13.3c0 1.6-1.3 2.9-2.9 2.9s-2.9-1.3-2.9-2.9 1.3-2.9 2.9-2.9c.3 0 .59.05.86.13V9.5c-.28-.04-.57-.06-.86-.06-3.28 0-5.94 2.66-5.94 5.94S6.19 21.32 9.47 21.32s5.94-2.66 5.94-5.94V9.01c1.24.88 2.75 1.4 4.38 1.4V7.28c-1.04 0-2-.36-2.75-.96l-.44-.5z"/>
                        </svg>
                    </div>

                    <p class="testimonio-card__texto">{{this.testimonio}}</p>

                    {{#if this.tiktokUrl}}
                        <div class="testimonio-card__footer">
                            <a href="{{this.tiktokUrl}}" target="_blank" rel="noopener noreferrer" style="color: inherit; font-size: 0.8rem; text-decoration: underline; opacity: 0.8;">Ver testimonio en TikTok ↗</a>
                        </div>
                    {{/if}}
                </div>
            {{/each}}
        </div>
    </div>
</section>