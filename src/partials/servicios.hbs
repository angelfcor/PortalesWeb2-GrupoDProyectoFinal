<section class="servicios">
    <div class="content">
        <h2 class="servicios__title">Lo Que Ofrecemos</h2>
        <p class="servicios__subtitle">Comodidades pensadas para que no te falte nada durante tu visita</p>
        <div class="grid">
            <div class="row justify-center">
                {{#each servicios}}
                    <div class="col-12 col-md-6 col-lg-4 p-3">
                        {{> servicio this}}
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>