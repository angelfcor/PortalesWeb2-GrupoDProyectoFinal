<section id="promociones" class="promociones">
    <div class="content">
        <h2 class="cardholder__title">Promociones</h2>
        <p class="cardholder__subtitle">
            Aprovecha nuestras mejores ofertas.
        </p>

        <div class="grid">
            <div class="row justify-center">
                {{#each promociones}}
                <div class="col-12 col-md-6 col-lg-4 p-3">
                    <div class="card">

                        <div class="card__header">
                            <img src="{{imagen}}" alt="{{titulo}}" class="cover-img" loading="lazy">
                            <span class="card__label">Oferta</span>
                        </div>

                        <div class="card__body">
                            <h2 class="card__title">{{titulo}}</h2>
                            <p class="card__description">{{descripcion}}</p>
                        </div>

                        <div class="card__footer">
                            <span class="card__price">HND {{precio}}</span>
                            <a class="card__cta" href="/reservaciones.html">
                                Reservar
                            </a>
                        </div>

                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>