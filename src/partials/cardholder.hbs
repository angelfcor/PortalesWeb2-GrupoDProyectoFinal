<section class="cardholder">
    <div class="content">
        <h2 class="cardholder__title">{{cardholder.title}}</h2>
        <p class="cardholder__subtitle">{{cardholder.subtitle}}</p>
        <div class="grid">
            <div class="row justify-center">
                {{#each cardholder.items}}
                    <div class="col-12 col-md-6 {{@root.cardholder.cols}} p-3">
                        {{> card}}
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>
