<section class="cardholder">
    <div class="content">
        <h2 class="cardholder__title">{{title}}</h2>
        <p class="cardholder__subtitle">{{subtitle}}</p>
        <div class="grid">
            <div class="row justify-center">
                {{#each items}}
                    <div class="col-12 col-md-6 {{../cols}} p-3">
                        {{> card this class=../cardClass}}
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>
