<section id="reservaciones" class="reservaciones">
    <div class="content">

        <h2 class="cardholder__title">Reservaciones</h2>

        <p class="cardholder__subtitle">
            Planifique su estadía en Hotel Fortuna. Complete el formulario y nuestro equipo confirmará su reserva.
        </p>

        <form class="reservation-form">

            <div class="form-row">

                <div class="form-group">
                    <label>Nombre completo</label>
                    <input type="text" placeholder="Ingrese su nombre">
                </div>

                <div class="form-group">
                    <label>Correo electrónico</label>
                    <input type="email" placeholder="ejemplo@correo.com">
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="tel" placeholder="9999-9999">
                </div>

                <div class="form-group">
                    <label>Habitación</label>
                    <select>
                        <option>2 Horas</option>
                        <option>5 Horas</option>
                        <option>5:00 p.m. a 9:00 a.m.</option>
                        <option>2 Días</option>
                    </select>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Fecha de entrada</label>
                    <input type="date">
                </div>

                <div class="form-group">
                    <label>Fecha de salida</label>
                    <input type="date">
                </div>

            </div>

            <div class="form-group">
                <label>Comentarios</label>
                <textarea placeholder="Escriba cualquier solicitud especial..."></textarea>
            </div>

            <button class="reservation-btn" type="submit">
                Reservar Habitación
            </button>

        </form>

    </div>
</section>