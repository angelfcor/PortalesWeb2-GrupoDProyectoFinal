<div class="promociones-card">
    <div class="promociones-card__img-wrapper">
        <img src="{{img}}" alt="{{alt}}" loading="lazy" />
        <span class="promociones-card__badge">{{label}}</span>
    </div>
    <div class="promociones-card__body">
        <h3>{{title}}</h3>
        <p>{{description}}</p>
        <a href="./reservaciones.html" class="promociones-card__cta">Reservar Ahora</a>
    </div>
</div>