<div class="card">

    <div class="card__header">

        <img
    src="{{img}}"
    alt="{{alt}}"
    class="cover-img"
    loading="lazy"
/>
        <span class="card__label">
            {{label}}
        </span>

    </div>

    <div class="card__body">

        <h2 class="card__title">
            {{title}}
        </h2>

        <p class="card__description">
            {{description}}
        </p>

    </div>

    <div class="card__footer">

        <a
            href="/reservaciones.html"
            class="card__cta">

            Reservar Ahora

        </a>

    </div>

</div>