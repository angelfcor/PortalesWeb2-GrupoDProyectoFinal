<section class="cardholder">
    <div class="content">
        <h2 class="cardholder__title">Galería</h2>
        <p class="cardholder__subtitle">
            Conoce algunos espacios de Hotel Fortuna
        </p>

        <div class="grid">
            <div class="row justify-center">
                {{#each galeria}}
                <div class="col-12 col-md-6 col-lg-3 p-3">
                    <div class="card">
                        <div class="card__header">
                            <img src="{{card_img}}" alt="{{card_title}}" loading="lazy">
                            <span class="card__label">{{card_label}}</span>
                        </div>

                        <div class="card__body">
                            <h2 class="card__title">{{card_title}}</h2>
                            <p class="card__description">
                                {{card_description}}
                            </p>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>