<div class="card">
    <div class="card__header">
        <img src="{{card_img}}" alt="{{card_title}}" class="cover-img" loading="lazy"/>
        <span class="card__label">{{card_label}}</span>
    </div>
    <div class="card__body">
        <h2 class="card__title">{{card_title}}</h2>
        <p class="card__description">{{card_description}}</p>
    </div>
    <div class="card__footer">
        <span class="card__price">HND {{card_price}}</span>
        <a class="card__cta" href="./reservaciones.html">{{card_cta}}</a>
    </div>
</div>