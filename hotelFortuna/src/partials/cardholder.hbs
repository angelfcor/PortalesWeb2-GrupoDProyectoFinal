<section class="cardholder">
    <div class="content">
        <h2 class="cardholder__title">Nuestras Tarifas</h2>
        <p class="cardholder__subtitle">Encuentra la opción perfecta para tu estadía</p>
        <div class="grid">
            <div class="row justify-center">
                {{#each tarifas}}
                    <div class="col-12 col-md-6 col-lg-3" style="padding: 0.75rem;">
                        {{> card this}}
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>